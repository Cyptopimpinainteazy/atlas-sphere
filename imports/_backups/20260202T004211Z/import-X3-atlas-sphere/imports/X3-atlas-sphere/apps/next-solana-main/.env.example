# =============================================================================
# SOUL SNATCHER - AI AGENT & INFLUENCER SYSTEM CONFIGURATION
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://username:password@localhost:5432/soul_snatcher"
REDIS_URL="redis://localhost:6379"

# -----------------------------------------------------------------------------
# API CONFIGURATION
# -----------------------------------------------------------------------------
API_PORT=3001
API_HOST="localhost"
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
CORS_ORIGIN="http://localhost:3000"

# -----------------------------------------------------------------------------
# LLM ORCHESTRATOR CONFIGURATION
# -----------------------------------------------------------------------------

# =============================================================================
# FREE LLM PROVIDERS SETUP
# =============================================================================
# Configure your free LLM providers for optimal performance and cost efficiency

# DeepSeek (Technical Analysis & Code Generation)
DEEPSEEK_API_KEY="sk-your-deepseek-api-key"
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODELS="deepseek-coder,deepseek-chat"
DEEPSEEK_ENABLED="true"

# Groq (Fast Trading Decisions & Real-time Analysis)
GROQ_API_KEY="gsk_your-groq-api-key"
GROQ_BASE_URL="https://api.groq.com/openai/v1"
GROQ_MODELS="mixtral-8x7b-32768,llama2-70b-4096"
GROQ_ENABLED="true"

# HuggingFace (Sentiment Analysis & NLP Tasks)
HUGGINGFACE_API_KEY="hf_your-huggingface-api-key"
HUGGINGFACE_MODELS="cardiffnlp/twitter-roberta-base-sentiment-latest,microsoft/DialoGPT-medium"
HUGGINGFACE_ENABLED="true"

# Ollama (Local/Private Processing)
OLLAMA_SERVER_URL="http://localhost:11434"
OLLAMA_MODELS="llama2,codellama,mistral"
OLLAMA_ENABLED="true"

# =============================================================================
# ORCHESTRATOR SETTINGS
# =============================================================================

# Task Routing Configuration
LLM_LOAD_BALANCING="weighted_response_time"  # round_robin | least_connections | weighted_response_time
LLM_CACHE_ENABLED="true"
LLM_CACHE_TTL="3600"  # seconds
LLM_CACHE_MAX_SIZE="1000"

# Cost Optimization
LLM_COST_OPTIMIZATION="false"
LLM_BUDGET_LIMIT="100"  # monthly budget in USD

# Circuit Breaker & Retry Configuration
LLM_CIRCUIT_BREAKER_THRESHOLD="5"
LLM_RETRY_ATTEMPTS="3"
LLM_RETRY_DELAY="1000"  # milliseconds

# Provider Priority (for fallback scenarios)
LLM_PROVIDER_PRIORITY="ollama,huggingface,groq,deepseek"

# =============================================================================
# LEGACY PROVIDERS (Optional - for premium features)
# =============================================================================

# OpenAI (Optional - for premium features)
OPENAI_API_KEY="sk-your-openai-api-key"

# Anthropic Claude (Optional)
ANTHROPIC_API_KEY="sk-ant-your-anthropic-api-key"

# -----------------------------------------------------------------------------
# SOLANA BLOCKCHAIN CONFIGURATION
# -----------------------------------------------------------------------------
SOLANA_RPC_URLS="https://api.mainnet-beta.solana.com,https://solana-mainnet.g.alchemy.com/v2/your-api-key,https://rpc.ankr.com/solana,https://ssc-dao.genesysgo.net"
SOLANA_WS_URL="wss://api.mainnet-beta.solana.com"
SOLANA_PRIVATE_KEY="your-base58-encoded-private-key"
SOLANA_NETWORK="mainnet-beta"

# Jupiter DEX Configuration
JUPITER_API_URL="https://quote-api.jup.ag/v6"

# Raydium Configuration
RAYDIUM_API_URL="https://api.raydium.io/v2"

# -----------------------------------------------------------------------------
# SOCIAL MEDIA PLATFORMS CONFIGURATION
# -----------------------------------------------------------------------------

# Twitter/X Configuration
TWITTER_API_KEY="your-twitter-api-key"
TWITTER_API_SECRET="your-twitter-api-secret"
TWITTER_ACCESS_TOKEN="your-twitter-access-token"
TWITTER_ACCESS_TOKEN_SECRET="your-twitter-access-token-secret"
TWITTER_BEARER_TOKEN="your-twitter-bearer-token"

# Advanced Twitter Features (for influencer growth)
TWITTER_CONSUMER_KEY="your-twitter-consumer-key"
TWITTER_CONSUMER_SECRET="your-twitter-consumer-secret"
TWITTER_CLIENT_ID="your-twitter-client-id"
TWITTER_CLIENT_SECRET="your-twitter-client-secret"

# Discord Configuration
DISCORD_BOT_TOKEN="your-discord-bot-token"
DISCORD_CLIENT_ID="your-discord-client-id"
DISCORD_CLIENT_SECRET="your-discord-client-secret"
DISCORD_GUILD_ID="your-discord-guild-id"

# Telegram Configuration
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_CHAT_ID="your-telegram-chat-id"
TELEGRAM_WEBHOOK_URL="https://your-domain.com/webhook/telegram"

# -----------------------------------------------------------------------------
# IMAGE GENERATION SERVICES
# -----------------------------------------------------------------------------

# HuggingFace Image Generation
HUGGINGFACE_IMAGE_API_KEY="hf_your-huggingface-api-key"
HUGGINGFACE_IMAGE_MODEL="stabilityai/stable-diffusion-2-1"

# Stability AI (Stable Diffusion)
STABILITY_API_KEY="sk-your-stability-api-key"
STABILITY_API_HOST="https://api.stability.ai"

# Local Stable Diffusion (via Ollama or local setup)
LOCAL_SD_URL="http://localhost:7860"
LOCAL_SD_ENABLED="false"

# Replicate (Alternative image generation)
REPLICATE_API_TOKEN="r8_your-replicate-api-token"

# -----------------------------------------------------------------------------
# CONTENT OPTIMIZATION SETTINGS
# -----------------------------------------------------------------------------

# Viral Content Thresholds
VIRAL_THRESHOLD="0.7"
VIRAL_SCORE_MIN="0.5"
VIRAL_BOOST_THRESHOLD="0.8"

# Content Generation Frequency
CONTENT_GENERATION_FREQUENCY="30"  # minutes
MAX_DAILY_POSTS="24"
MIN_POST_INTERVAL="15"  # minutes between posts

# Content Quality Settings
MIN_CONTENT_SCORE="0.6"
ENABLE_CONTENT_FILTERING="true"
PROFANITY_FILTER_ENABLED="true"

# Trend Detection Settings
TREND_UPDATE_INTERVAL="10"  # minutes
TREND_SENSITIVITY="0.6"
MAX_TRENDS_TO_TRACK="50"

# -----------------------------------------------------------------------------
# INFLUENCER SYSTEM SETTINGS
# -----------------------------------------------------------------------------

# Auto-Follow Configuration
ENABLE_AUTO_FOLLOW="true"
MAX_FOLLOWS_PER_HOUR="30"
MAX_FOLLOWS_PER_DAY="200"
FOLLOW_BACK_RATIO="0.3"
UNFOLLOW_DELAY_HOURS="72"

# Viral Campaign Management
ENABLE_VIRAL_CAMPAIGNS="true"
MAX_ACTIVE_CAMPAIGNS="5"
CAMPAIGN_BUDGET_LIMIT="1000"  # in USD equivalent
AUTO_CAMPAIGN_OPTIMIZATION="true"

# Community Management
COMMUNITY_MANAGEMENT_ENABLED="true"
AUTO_MODERATION_ENABLED="true"
WELCOME_NEW_MEMBERS="true"
AUTO_RESPONSE_ENABLED="true"

# Engagement Automation
AUTO_LIKE_ENABLED="true"
AUTO_RETWEET_ENABLED="true"
AUTO_COMMENT_ENABLED="true"
MAX_ENGAGEMENTS_PER_HOUR="60"

# Growth Strategy Settings
AGGRESSIVE_GROWTH_MODE="false"
ORGANIC_GROWTH_ONLY="true"
TARGET_FOLLOWER_GROWTH_RATE="5"  # percentage per week
ENGAGEMENT_RATE_TARGET="3.5"  # percentage

# -----------------------------------------------------------------------------
# RATE LIMITING & SAFETY SETTINGS
# -----------------------------------------------------------------------------

# API Rate Limits
TWITTER_RATE_LIMIT_REQUESTS="300"  # per 15 minutes
DISCORD_RATE_LIMIT_REQUESTS="50"   # per minute
TELEGRAM_RATE_LIMIT_REQUESTS="30"  # per second

# Content Safety
ENABLE_CONTENT_MODERATION="true"
TOXICITY_THRESHOLD="0.7"
SPAM_DETECTION_ENABLED="true"
DUPLICATE_CONTENT_CHECK="true"

# Platform Safety Limits
MAX_ACTIONS_PER_HOUR="100"
COOLDOWN_PERIOD_MINUTES="5"
ERROR_RETRY_ATTEMPTS="3"
BACKOFF_MULTIPLIER="2"

# -----------------------------------------------------------------------------
# ANALYTICS & MONITORING
# -----------------------------------------------------------------------------

# Performance Tracking
ENABLE_ANALYTICS="true"
ANALYTICS_RETENTION_DAYS="90"
REAL_TIME_METRICS="true"

# Monitoring & Alerts
ENABLE_PERFORMANCE_ALERTS="true"
ALERT_EMAIL="admin@yourdomain.com"
SLACK_WEBHOOK_URL="https://hooks.slack.com/your-webhook-url"

# Metrics Collection
COLLECT_ENGAGEMENT_METRICS="true"
COLLECT_GROWTH_METRICS="true"
COLLECT_CONTENT_METRICS="true"
METRICS_UPDATE_INTERVAL="5"  # minutes

# -----------------------------------------------------------------------------
# SENTIMENT ANALYSIS & MARKET DATA
# -----------------------------------------------------------------------------

# Sentiment Analysis
ENABLE_SENTIMENT_ANALYSIS="true"
SENTIMENT_UPDATE_INTERVAL="15"  # minutes
FUD_DETECTION_ENABLED="true"
BULLISH_SENTIMENT_THRESHOLD="0.6"

# Market Data Sources
COINGECKO_API_KEY="your-coingecko-api-key"
COINMARKETCAP_API_KEY="your-coinmarketcap-api-key"
DEXSCREENER_API_URL="https://api.dexscreener.com/latest"

# News & Social Sentiment
NEWS_API_KEY="your-news-api-key"
REDDIT_CLIENT_ID="your-reddit-client-id"
REDDIT_CLIENT_SECRET="your-reddit-client-secret"

# -----------------------------------------------------------------------------
# SCHEDULING & AUTOMATION
# -----------------------------------------------------------------------------

# Content Scheduling
ENABLE_SMART_SCHEDULING="true"
OPTIMAL_POSTING_TIMES="09:00,12:00,15:00,18:00,21:00"  # UTC times
TIMEZONE="UTC"
WEEKEND_POSTING_ENABLED="true"

# Automation Settings
AUTO_CAMPAIGN_LAUNCH="false"
AUTO_TREND_PARTICIPATION="true"
AUTO_HASHTAG_OPTIMIZATION="true"
CROSS_PLATFORM_SYNC="true"

# Job Queue Configuration
REDIS_QUEUE_URL="redis://localhost:6379/1"
MAX_CONCURRENT_JOBS="10"
JOB_RETRY_ATTEMPTS="3"

# -----------------------------------------------------------------------------
# SECURITY & PRIVACY
# -----------------------------------------------------------------------------

# API Security
API_RATE_LIMIT="1000"  # requests per hour per IP
ENABLE_API_KEY_AUTH="true"
REQUIRE_HTTPS="true"

# Data Privacy
ANONYMIZE_USER_DATA="true"
DATA_RETENTION_DAYS="365"
GDPR_COMPLIANCE="true"

# Encryption
ENCRYPTION_KEY="your-32-character-encryption-key"
HASH_SALT="your-unique-salt-string"

# -----------------------------------------------------------------------------
# DEVELOPMENT & DEBUGGING
# -----------------------------------------------------------------------------

# Environment
NODE_ENV="development"
DEBUG_MODE="true"
LOG_LEVEL="info"

# Development Tools
ENABLE_DEV_TOOLS="true"
MOCK_SOCIAL_APIS="false"
SIMULATE_GROWTH="false"

# Logging
LOG_FILE_PATH="./logs/app.log"
LOG_ROTATION="daily"
LOG_MAX_SIZE="100MB"

# Testing
TEST_MODE="false"
MOCK_PAYMENTS="true"
SANDBOX_MODE="true"

# -----------------------------------------------------------------------------
# FEATURE FLAGS
# -----------------------------------------------------------------------------

# Core Features
ENABLE_TRADING="true"
ENABLE_SOCIAL_MEDIA="true"
ENABLE_INFLUENCER_MODE="true"
ENABLE_MEME_GENERATION="true"

# Experimental Features
ENABLE_AI_VOICE="false"
ENABLE_VIDEO_GENERATION="false"
ENABLE_ADVANCED_ANALYTICS="true"
ENABLE_MULTI_LANGUAGE="false"

# Platform Specific Features
ENABLE_TWITTER_SPACES="false"
ENABLE_DISCORD_VOICE="false"
ENABLE_TELEGRAM_CHANNELS="true"
ENABLE_YOUTUBE_INTEGRATION="false"

# -----------------------------------------------------------------------------
# BACKUP & RECOVERY
# -----------------------------------------------------------------------------

# Database Backup
AUTO_BACKUP_ENABLED="true"
BACKUP_INTERVAL_HOURS="24"
BACKUP_RETENTION_DAYS="30"
BACKUP_STORAGE_PATH="./backups"

# Cloud Storage (Optional)
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_S3_BUCKET="your-backup-bucket"
AWS_REGION="us-east-1"

# -----------------------------------------------------------------------------
# NOTIFICATIONS
# -----------------------------------------------------------------------------

# Email Notifications
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
EMAIL_FROM="noreply@yourdomain.com"

# Push Notifications
PUSH_NOTIFICATION_ENABLED="false"
FIREBASE_SERVER_KEY="your-firebase-server-key"

# -----------------------------------------------------------------------------
# CUSTOM CONFIGURATION
# -----------------------------------------------------------------------------

# Custom API Endpoints
CUSTOM_API_ENDPOINT="https://your-custom-api.com"
WEBHOOK_SECRET="your-webhook-secret"

# Third-party Integrations
ZAPIER_WEBHOOK_URL="https://hooks.zapier.com/your-webhook"
IFTTT_WEBHOOK_KEY="your-ifttt-webhook-key"

# Custom Models
CUSTOM_MODEL_ENDPOINT="http://localhost:8080/v1"
CUSTOM_MODEL_API_KEY="your-custom-model-key"
