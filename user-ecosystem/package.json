{
  "name": "@atlas-sphere/user-ecosystem",
  "version": "1.0.0",
  "private": true,
  "description": "Atlas Sphere User Ecosystem - Desktop, Browser Extension, Web Portal",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:desktop": "npm run dev -w @atlas-sphere/desktop",
    "dev:extension": "npm run dev -w @atlas-sphere/browser-extension",
    "dev:portal": "npm run dev -w @atlas-sphere/web-portal",
    "build:all": "npm run build -w @atlas-sphere/shared && npm run build --workspaces --if-present",
    "build:desktop": "npm run build -w @atlas-sphere/desktop",
    "build:extension": "npm run build -w @atlas-sphere/browser-extension",
    "build:portal": "npm run build -w @atlas-sphere/web-portal",
    "test": "npm test --workspaces --if-present",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^3.1.1",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
