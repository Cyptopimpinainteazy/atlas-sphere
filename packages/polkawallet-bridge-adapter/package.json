{
  "name": "@atlas-sphere/polkawallet-bridge-adapter",
  "version": "0.1.0",
  "description": "Polkawallet bridge adapter for Atlas Sphere x3chain — XCM, cross-chain transfers, and multi-chain routing",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.mjs",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --sourcemap --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --sourcemap --watch",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit"
  },
  "files": ["dist", "src", "README.md"],
  "keywords": [
    "polkawallet", "bridge", "xcm", "atlas-sphere", "x3chain",
    "cross-chain", "substrate", "polkadot"
  ],
  "author": "Atlas Sphere Team",
  "license": "Apache-2.0",
  "dependencies": {
    "@polkadot/api": "^14.0.1",
    "@polkadot/types": "^14.0.1",
    "@polkadot/util": "^13.0.0",
    "@polkadot/util-crypto": "^13.0.0",
    "eventemitter3": "^5.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  },
  "peerDependencies": {
    "@atlas-sphere/polkawallet-plugin": ">=0.1.0"
  }
}
