{
  "name": "@atlas-sphere/ts-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for Atlas Sphere",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "keywords": [
    "atlas-sphere",
    "blockchain",
    "sdk",
    "typescript",
    "substrate",
    "polkadot"
  ],
  "author": "Atlas Sphere Team",
  "license": "Apache-2.0",
  "dependencies": {
    "@polkadot/api": "^10.11.0",
    "@polkadot/types": "^10.11.0",
    "@polkadot/util": "^12.6.0",
    "@polkadot/util-crypto": "^12.6.0",
    "ethers": "^6.8.0",
    "@solana/web3.js": "^1.87.0",
    "axios": "^1.6.0",
    "eventemitter3": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "eslint": "^8.55.0",
    "prettier": "^3.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/atlas-sphere/ts-sdk.git"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}