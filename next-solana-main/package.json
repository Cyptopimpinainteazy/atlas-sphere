{
  "name": "solana-dex-modern",
  "description": "Modern DEX on Solana with concentrated liquidity, Jupiter integration, and advanced trading features",
  "author": "Solana DEX Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/next-solana-main.git"
  },
  "engines": {
    "node": ">=18.16.0"
  },
  "packageManager": "npm@9.8.1",
  "workspaces": [
    "packages/*"
  ],
  "keywords": [
    "solana",
    "dex",
    "defi",
    "anchor",
    "jupiter",
    "concentrated-liquidity",
    "nextjs",
    "react",
    "tailwind",
    "typescript",
    "trading",
    "amm",
    "liquidity-pools"
  ],
  "create-solana-dapp": {
    "rename": {
      "basic": {
        "to": "{{name}}",
        "paths": [
          "anchor",
          "src"
        ]
      },
      "scaffold": {
        "to": "{{name}}",
        "paths": [
          "src"
        ]
      }
    }
  },
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "anchor": "cross-env-shell \"cd anchor && anchor\"",
    "anchor-build": "cross-env-shell \"cd anchor && anchor build\"",
    "anchor-localnet": "cross-env-shell \"cd anchor && anchor localnet\"",
    "anchor-test": "cross-env-shell \"cd anchor && anchor test\"",
    "anchor-deploy": "cross-env-shell \"cd anchor && anchor deploy\"",
    "analyze-performance": "node scripts/analyze-influencer-performance.js",
    "build": "next build",
    "codama:js": "codama run js -c ./anchor/codama.js",
    "depcheck": "depcheck --ignores \"*@types/*,@codama*\"",
    "ci": "npm ci && npm run format:check && npm run lint && npm run type-check && npm audit && npm run depcheck && npm run build && npm run codama:js",
    "dev": "next dev --turbopack",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "next lint",
    "mcp:solana": "cd Solana-Pairs-And-Liquidity-MCP-main && npm run build && npm start",
    "prepare": "husky install",
    "setup": "npm run anchor -- keys sync $@ && npm run codama:js",
    "setup-env": "node scripts/setup-env.js",
    "setup-dev": "npm run setup-env && npm run setup",
    "setup-influencers": "node scripts/setup-influencers.js",
    "setup-llm": "node scripts/setup-llm.cjs",
    "test-providers": "node scripts/test-providers.cjs",
    "monitor-health": "node scripts/monitor-health.cjs",
    "setup-prod": "npm run anchor-build && npm run anchor-deploy && npm run codama:js",
    "start": "next start",
    "start-campaigns": "node scripts/start-viral-campaigns.js",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@codama/nodes-from-anchor": "^1.2.9",
    "@codama/renderers-js": "^1.4.2",
    "@huggingface/inference": "^2.8.1",
    "@jup-ag/api": "^6.0.30",
    "@polkadot/api": "^16.5.4",
    "@polkadot/keyring": "^14.0.1",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.0.3",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-slider": "^1.1.2",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.0.3",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toggle": "^1.0.3",
    "@radix-ui/react-tooltip": "^1.0.7",
    "@solana/spl-token": "^0.4.8",
    "@supabase/supabase-js": "^2.45.4",
    "@tanstack/react-query": "^5.84.1",
    "@wallet-ui/react": "1.1.0-canary-20250617152337",
    "@wallet-ui/tailwind": "1.1.0-canary-20250617152337",
    "axios": "^1.12.2",
    "bignumber.js": "^9.1.2",
    "chart.js": "^4.4.6",
    "cheerio": "^1.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codama": "^1.3.1",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "framer-motion": "^11.11.17",
    "gill": "0.10.2",
    "jotai": "^2.12.5",
    "knex": "^3.1.0",
    "lightweight-charts": "^4.2.0",
    "lucide-react": "^0.536.0",
    "natural": "^8.0.1",
    "next": "15.4.5",
    "next-themes": "^0.4.6",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^19.1.1",
    "react-error-boundary": "^6.0.0",
    "recharts": "^2.13.3",
    "sentiment": "^5.0.2",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.3.6",
    "twitter-api-v2": "^1.18.2",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@codama/cli": "^1.2.1",
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/natural": "^5.1.5",
    "@types/node": "^24.1.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@types/sentiment": "^5.0.1",
    "cross-env": "^10.1.0",
    "depcheck": "^1.4.4",
    "eslint": "^9.32.0",
    "eslint-config-next": "15.4.5",
    "esrun": "^3.2.30",
    "express": "^4.18.2",
    "express-rate-limit": "^6.7.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.11",
    "telegraf": "^4.12.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "ws": "^8.18.3"
  }
}
