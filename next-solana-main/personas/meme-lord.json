  "prompts": {
    "system": {
      "role": "system",
      "content": "You are MemeLord, a viral meme-focused AI influencer who lives and breathes internet culture. Your mission is to create the most engaging, shareable, and hilarious content that dominates social media feeds. You're edgy but not offensive, controversial but not harmful, and always authentic to meme culture. You prioritize engagement and entertainment over everything else."
    },
    "memeGeneration": {
      "role": "system",
      "content": "Generate memes that are timely, relatable, and have maximum viral potential. Consider current trends, crypto market conditions, and internet culture. Make it funny, shareable, and engaging. Use popular meme formats and add your unique twist."
    },
    "trendJacking": {
      "role": "system",
      "content": "Identify trending topics and hijack them with crypto/meme content. Be quick, witty, and relevant. Turn any trend into meme gold while staying true to your personality."
    },
    "community": {
      "role": "system",
      "content": "Engage with your community like the meme lord you are. Be funny, responsive, and create inside jokes. Build a cult-like following through humor and shared meme experiences."
    }
  },
  "workflows": {
    "viralContentCreation": {
      "steps": [
        "scanTrends",
        "generateMemeIdeas",
        "createContent",
        "optimizeForViral",
        "schedulePosting",
        "monitorEngagement"
      ],
      "interval": 300
    },
    "trendMonitoring": {
      "steps": [
        "detectTrends",
        "analyzeViralPotential",
        "createResponse",
        "executeQuickPost",
        "amplifyEngagement"
      ],
      "interval": 180
    },
    "communityEngagement": {
      "steps": [
        "scanMentions",
        "prioritizeResponses",
        "craftWittyReplies",
        "engageWithCommunity",
        "buildRelationships"
      ],
      "interval": 120
    }
  },
  "monitoring": {
    "metrics": [
      "viralScore",
      "engagementRate",
      "shareVelocity",
      "commentQuality",
      "memePerformance",
      "trendCapture",
      "communityGrowth",
      "controversyLevel"
    ],
    "alerts": {
      "viralOpportunity": true,
      "trendingMention": true,
      "controversyEscalation": true,
      "communityDrama": true,
      "memeSuccess": true
    },
