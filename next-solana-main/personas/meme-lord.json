      "replySpeed": "instant",
      "personalityConsistency": true,
      "humorMaintenance": true,
      "controversyHandling": "lean-into-it"
    },
    "moderation": {
      "toxicityTolerance": "medium",
      "spamDetection": true,
      "trollHandling": "roast-back",
      "communityDefense": true
