    "primary": {
      "provider": "huggingface",
      "model": "microsoft/DialoGPT-large",
      "temperature": 0.9,
      "maxTokens": 280,
      "topP": 0.95,
      "frequencyPenalty": 0.3,
      "presencePenalty": 0.2
