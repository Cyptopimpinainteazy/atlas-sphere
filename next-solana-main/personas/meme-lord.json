    "secondary": {
      "provider": "groq",
      "model": "mixtral-8x7b-32768",
      "temperature": 0.8,
      "maxTokens": 500,
      "topP": 0.9,
      "frequencyPenalty": 0.2,
      "presencePenalty": 0.1
