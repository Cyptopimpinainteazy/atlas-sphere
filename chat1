// x3_vm/src/executor.rs
use std::collections::HashMap;
use bytes::Bytes;

// Basic types
pub type Reg = u64;
pub type Gas = u128;
pub type Address = [u8; 20];

pub struct VMConfig {
    pub stack_limit: usize,
    pub linear_mem_pages: usize,
    pub max_call_depth: usize,
}

pub struct Frame {
    pub locals: Vec<Reg>,
    pub return_pc: usize,
    pub mem_offset: usize,
}

pub struct X3VM {
    pub regs: [Reg; 32],
    pub vregs: [[u8;32]; 8], // vector registers
    pub stack: Vec<Reg>,
    pub linear_mem: Vec<u8>,
    pub pc: usize,
    pub gas: Gas,
    pub frames: Vec<Frame>,
    pub code: Vec<u8>,
    pub constants: Vec<Vec<u8>>,
    pub syscall_handlers: HashMap<u16, Box<dyn Fn(&[u8]) -> Vec<u8>>>,
}

impl X3VM {
    pub fn new(code: Vec<u8>, consts: Vec<Vec<u8>>, gas_limit: Gas, cfg: VMConfig) -> Self {
        Self {
            regs: [0u64; 32],
            vregs: [[0u8;32];8],
            stack: Vec::new(),
            linear_mem: vec![0u8; cfg.linear_mem_pages * 64 * 1024],
            pc: 0,
            gas: gas_limit,
            frames: Vec::new(),
            code,
            constants: consts,
            syscall_handlers: HashMap::new(),
        }
    }

    pub fn step(&mut self) -> Result<(), String> {
        if self.pc >= self.code.len() { return Err("PC OOB".into()); }
        let opcode = self.code[self.pc];
        self.pc += 1;
        match opcode {
            0x01 => { /* NOP */ self.charge(1)?; Ok(()) }
            0x07 => { /* ADD regA, regB, regC */ 
                let a = self.read_u8()? as usize; let b = self.read_u8()? as usize; let c = self.read_u8()? as usize;
                self.regs[a] = self.regs[b].wrapping_add(self.regs[c]);
                self.charge(2)?;
                Ok(())
            }
            0x30 => { /* READ_STATE key_idx, dst */
                let key_idx = self.read_u16()? as usize;
                let dst = self.read_u8()? as usize;
                let key = &self.constants[key_idx];
                if let Some(handler) = self.syscall_handlers.get(&0x30) {
                    let ret = handler(key);
                    // decode ret into register or memory as per ABI
                }
                self.charge(30)?;
                Ok(())
            }
            0x60 => { /* ATOMIC_BEGIN */ self.charge(5)?; Ok(()) }
            0x61 => { /* ATOMIC_END */ self.charge(5)?; Ok(()) }
            0xF1 => { /* HALT */ return Err("HALT".into()) }
            _ => Err(format!("Invalid opcode {:x}", opcode))
        }
    }

    fn charge(&mut self, amount: u128) -> Result<(), String> {
        if self.gas < amount { return Err("OutOfGas".into()); }
        self.gas -= amount;
        Ok(())
    }

    fn read_u8(&mut self) -> Result<u8, String> {
        if self.pc >= self.code.len() { return Err("PC OOB".into()); }
        let v = self.code[self.pc];
        self.pc += 1;
        Ok(v)
    }
    fn read_u16(&mut self) -> Result<u16, String> {
        let lo = self.read_u8()? as u16; let hi = self.read_u8()? as u16;
        Ok((hi << 8) | lo)
    }
}
