## examples/ERC20.x3

```x3
pragma x3 ^1.0.0;
import "std::storage" as Storage;
import "std::event" as Event;

contract ERC20 {
  const SLOT = b"erc20_v1:";

  pub fn totalSupply() -> u256 {
    return Storage::load_u256(concat(SLOT, b"total"));
  }

  pub fn balanceOf(addr: Address) -> u256 {
    return Storage::load_u256(concat(SLOT, b"bal:", addr));
  }

  pub fn transfer(to: Address, amount: u256) -> bool {
    let from = msg.sender;
    let balFrom = self.balanceOf(from);
    require(balFrom >= amount, "insufficient");
    Storage::store_u256(concat(SLOT, b"bal:", from), balFrom - amount);
    Storage::store_u256(concat(SLOT, b"bal:", to), self.balanceOf(to) + amount);
    Event::emit("Transfer", {from: from, to: to, value: amount});
    return true;
  }

  constructor(initial: u256) {
    Storage::store_u256(concat(SLOT, b"total"), initial);
    Storage::store_u256(concat(SLOT, b"bal:", msg.sender), initial);
  }
}
