import "std::storage" as Storage;
import "std::event" as Event;
import "std::crypto" as Crypto;

contract HTLC {
  const SLOT = b"htlc_v1:";

  pub fn lock(id: FixedBytes<32>, taker: Address, hashlock: FixedBytes<32>, timelock: Timestamp) {
    require(block.timestamp < timelock, "timelock");
    Storage::store_bytes(concat(SLOT, id, b":maker"), msg.sender);
    Storage::store_bytes(concat(SLOT, id, b":hash"), hashlock);
    Storage::store_u64(concat(SLOT, id, b":time"), timelock);
    Event::emit("Locked", {id: id, maker: msg.sender, taker: taker});
  }

  pub fn claim(id: FixedBytes<32>, preimage: Bytes) {
    let hash = Crypto::sha256(preimage);
    let stored = Storage::load_bytes(concat(SLOT, id, b":hash"));
    require(hash == stored, "bad preimage");
    // Host::transfer_native or Token transfer helper
    Event::emit("Claimed", {id: id});
    Event::emit("Preimage", {id: id, preimage: preimage});
  }

  pub fn refund(id: FixedBytes<32>) {
    let timelock = Storage::load_u64(concat(SLOT, id, b":time"));
    require(block.timestamp >= timelock, "still locked");
    // refund flow
  }
}
