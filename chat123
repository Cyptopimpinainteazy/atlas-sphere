import { AtomicBundle, VMCall } from './types';
import axios from 'axios';
import { keccak256 } from 'ethers/lib/utils';

export function makeBundle(sender: string, calls: VMCall[], maxXu: number): AtomicBundle {
  const id = keccak256(Buffer.from(JSON.stringify({ sender, calls, maxXu })));
  return { bundleId: id, sender, calls, maxXu };
