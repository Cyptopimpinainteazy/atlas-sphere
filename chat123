from dimod import BinaryQuadraticModel
import numpy as np

# Example data
P = 4           # paths
K = 10          # buckets per path
bucket_size = 10
S = 150         # total order size
slippage = np.random.rand(P, K)  # estimated slippage per bucket

# Map variables to integer keys
vars = {(p,k): f"x_{p}_{k}" for p in range(P) for k in range(K)}

bqm = BinaryQuadraticModel({}, {}, 0.0, vartype='BINARY')

# Linear costs: slippage * x
for p in range(P):
    for k in range(K):
        bqm.add_variable(vars[(p,k)], slippage[p,k])

# Capacity constraint: sum_k,p bucket_size * x_{p,k} == S  (soft-constrained)
# Add quadratic penalty (sum - S)^2 * lambda
lam = 10.0
# Expand (sum - S)^2 = sum_i sum_j x_i x_j * bucket_size^2 - 2S*sum_i bucket_size*x_i + S^2
keys = list(vars.values())
for i in range(len(keys)):
    bqm.add_linear(keys[i], bqm.get_linear(keys[i]) + lam * (-2*S*bucket_size))
    for j in range(i, len(keys)):
        bqm.add_quadratic(keys[i], keys[j], lam * (bucket_size**2))

