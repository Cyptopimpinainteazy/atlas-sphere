X3 syntax is C/TypeScript-like with emphasis on clarity. Example hello contract:

contract Token {
  pub var totalSupply: u256;

  constructor(initial: u256) {
    self.totalSupply = initial;
  }

  pub fn balanceOf(addr: Address) -> u256 {
    return Storage::load_u256(concat("bal:", addr));
  }

  pub fn transfer(to: Address, amount: u256) -> bool {
    let from = msg.sender;
    let balFrom = self.balanceOf(from);
    require(balFrom >= amount, "insufficient");
    Storage::store_u256(concat("bal:", from), balFrom - amount);
    let balTo = self.balanceOf(to);
    Storage::store_u256(concat("bal:", to), balTo + amount);
    Event::emit("Transfer", {from: from, to: to, value: amount});
    return true;
  }
}
Key lexical elements: contract, struct, enum, fn, let, const, if/else, match, loop, return, event, import.

