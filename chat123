# Pseudocode (Python-style) for scheduler core
class VMCall:
    def __init__(self, vm_name: str, payload: bytes, gas_native: int):
        self.vm_name = vm_name
        self.payload = payload
        self.gas_native = gas_native

class AtomicBundle:
    def __init__(self, bundle_id: bytes32, sender: Address, calls: List[VMCall], max_xu: int, signature: Signature):
        self.bundle_id = bundle_id
        self.sender = sender
        self.calls = calls
        self.max_xu = max_xu
        self.signature = signature

class Scheduler:
    def submit_bundle(self, bundle: AtomicBundle):
        self.preflight(bundle)
        self.reserve_gas(bundle.sender, bundle.max_xu)
        snapshot = self.snapshot_state()  # create checkpoint across all VMs
        receipts = []
        try:
            for i, call in enumerate(bundle.calls):
                xu_cost = convert_to_xu(call.vm_name, call.gas_native)
                if xu_cost > remaining_xu:
                    raise OutOfGas()
                result = execute_vm_call(call)
                receipts.append(make_receipt(call, result))
                remaining_xu -= xu_cost
            commit_block_level_receipts(bundle.bundle_id, receipts)
            charge_fees(bundle.sender, bundle.max_xu - remaining_xu)
        except Exception as e:
            self.revert_to_snapshot(snapshot)
            charge_partial_fee(bundle.sender, compute_partial_xu_used())
            raise e


