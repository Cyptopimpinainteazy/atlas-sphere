Pseudocode (PyTorch + PennyLane):

import pennylane as qml
import torch
import torch.nn as nn

class HybridModel(nn.Module):
    def __init__(self, n_qubits=4, embed_size=16):
        super().__init__()
        self.lstm = nn.LSTM(input_size=features, hidden_size=embed_size, batch_first=True)
        # quantum device
        dev = qml.device('default.qubit', wires=n_qubits)
        @qml.qnode(dev, interface='torch')
        def circuit(inputs, weights):
            # encode inputs into rotations
            for i in range(n_qubits):
                qml.RY(inputs[i], wires=i)
            # variational layers
            qml.templates.StronglyEntanglingLayers(weights, wires=range(n_qubits))
            return [qml.expval(qml.PauliZ(i)) for i in range(n_qubits)]
        self.qnode = circuit
        # trainable weights
        self.weights = nn.Parameter(torch.randn(3, n_qubits, 3))
        self.fc = nn.Linear(n_qubits, 1)
    def forward(self, x):
        # x: batch, seq_len, features
        out, _ = self.lstm(x)
        embed = out[:, -1, :]  # last output
        # reduce/embed vector to n_qubits size (simple linear)
        enc = nn.Linear(embed.size(1), self.qnode.num_wires)(embed)
        qout = self.qnode(enc, self.weights)
        qout = torch.stack(qout, dim=1)
        return self.fc(qout).squeeze(-1)
