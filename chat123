Example Solidity change (safe, minimal pattern):

// SPDX: MIT
pragma solidity ^0.8.19;

contract AtomicSwapAdapter {
    struct Swap {
        address maker;
        address taker;
        uint256 amount;
        bytes32 hashlock; // sha256 preimage hash (bytes32)
        uint256 timelock; // unix timestamp
        bool claimed;
        bool refunded;
    }

    mapping(bytes32 => Swap) public swaps;

    event Locked(bytes32 indexed id, address indexed maker, address taker, uint256 amount, bytes32 hashlock, uint256 timelock);
    event Claimed(bytes32 indexed id, bytes preimage);
    event Refunded(bytes32 indexed id);

    // lock with sha256 hash H
    function lockTokens(bytes32 id, address taker, uint256 timelock, bytes32 hashlock) external payable {
        require(swaps[id].maker == address(0), "swap exists");
        require(timelock >= block.timestamp + 3600, "min 1 hour");
        require(timelock <= block.timestamp + 7 days, "max 7 days");

        swaps[id] = Swap({
            maker: msg.sender,
            taker: taker,
            amount: msg.value,
            hashlock: hashlock,
            timelock: timelock,
            claimed: false,
            refunded: false
        });

        emit Locked(id, msg.sender, taker, msg.value, hashlock, timelock);
    }

    // claim with preimage P
    function claim(bytes32 id, bytes calldata preimage) external {
        Swap storage s = swaps[id];
        require(!s.claimed && !s.refunded, "closed");
        require(msg.sender == s.taker, "not taker");
        bytes32 h = sha256(preimage);
        require(h == s.hashlock, "bad preimage");
        s.claimed = true;
        payable(s.taker).transfer(s.amount);
        emit Claimed(id, preimage);
    }

    // refund after timelock
    function refund(bytes32 id) external {
        Swap storage s = swaps[id];
        require(!s.claimed && !s.refunded, "closed");
        require(block.timestamp >= s.timelock, "timelock");
        require(msg.sender == s.maker, "not maker");
        s.refunded = true;
        payable(s.maker).transfer(s.amount);
        emit Refunded(id);
    }
}
Notes:

Use sha256(preimage) so the same preimage verifies against a Bitcoin HTLC created with OP_SHA256.

id can be keccak256(abi.encodePacked(maker,taker,hashlock,timelock,nonce)) to avoid collisions.

Always emit the preimage on Claim so relayers/watchtowers can observe it and trigger the BTC side claim.

