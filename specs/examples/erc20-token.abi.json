{
  "name": "ERC20Token",
  "version": "1.0.0",
  "description": "Standard fungible token implementation for Atlas Sphere",
  "author": "Atlas Sphere Team",
  "license": "MIT",
  "compiler": {
    "name": "x3c",
    "version": "0.1.0"
  },
  "types": {
    "Balance": {
      "kind": "alias",
      "underlying": "u256"
    }
  },
  "storage": {
    "total_supply": {
      "type": "u256",
      "slot": 0,
      "description": "Total token supply"
    },
    "balances": {
      "type": "Map<address, u256>",
      "slot": 1,
      "description": "Account balances"
    },
    "allowances": {
      "type": "Map<address, Map<address, u256>>",
      "slot": 2,
      "description": "Spending allowances (owner => spender => amount)"
    },
    "name": {
      "type": "string",
      "slot": 3,
      "description": "Token name"
    },
    "symbol": {
      "type": "string",
      "slot": 4,
      "description": "Token symbol"
    },
    "decimals": {
      "type": "u8",
      "slot": 5,
      "description": "Decimal places"
    }
  },
  "functions": [
    {
      "name": "name",
      "inputs": [],
      "outputs": [{ "name": "name", "type": "string" }],
      "visibility": "public",
      "mutability": "view",
      "selector": "0x06fdde03",
      "description": "Returns the token name"
    },
    {
      "name": "symbol",
      "inputs": [],
      "outputs": [{ "name": "symbol", "type": "string" }],
      "visibility": "public",
      "mutability": "view",
      "selector": "0x95d89b41",
      "description": "Returns the token symbol"
    },
    {
      "name": "decimals",
      "inputs": [],
      "outputs": [{ "name": "decimals", "type": "u8" }],
      "visibility": "public",
      "mutability": "view",
      "selector": "0x313ce567",
      "description": "Returns decimal places"
    },
    {
      "name": "total_supply",
      "inputs": [],
      "outputs": [{ "name": "supply", "type": "u256" }],
      "visibility": "public",
      "mutability": "view",
      "selector": "0x18160ddd",
      "description": "Returns total token supply"
    },
    {
      "name": "balance_of",
      "inputs": [{ "name": "account", "type": "address" }],
      "outputs": [{ "name": "balance", "type": "u256" }],
      "visibility": "public",
      "mutability": "view",
      "selector": "0x70a08231",
      "description": "Returns balance of an account",
      "gas_estimate": 2500
    },
    {
      "name": "allowance",
      "inputs": [
        { "name": "owner", "type": "address" },
        { "name": "spender", "type": "address" }
      ],
      "outputs": [{ "name": "remaining", "type": "u256" }],
      "visibility": "public",
      "mutability": "view",
      "selector": "0xdd62ed3e",
      "description": "Returns spending allowance"
    },
    {
      "name": "transfer",
      "inputs": [
        { "name": "to", "type": "address" },
        { "name": "amount", "type": "u256" }
      ],
      "outputs": [{ "name": "success", "type": "bool" }],
      "visibility": "public",
      "mutability": "mutable",
      "selector": "0xa9059cbb",
      "description": "Transfer tokens to address",
      "gas_estimate": 50000,
      "examples": [
        {
          "description": "Transfer 100 tokens",
          "inputs": { "to": "0x1234...", "amount": "100000000000000000000" },
          "outputs": { "success": true }
        }
      ]
    },
    {
      "name": "approve",
      "inputs": [
        { "name": "spender", "type": "address" },
        { "name": "amount", "type": "u256" }
      ],
      "outputs": [{ "name": "success", "type": "bool" }],
      "visibility": "public",
      "mutability": "mutable",
      "selector": "0x095ea7b3",
      "description": "Approve spending allowance",
      "gas_estimate": 45000
    },
    {
      "name": "transfer_from",
      "inputs": [
        { "name": "from", "type": "address" },
        { "name": "to", "type": "address" },
        { "name": "amount", "type": "u256" }
      ],
      "outputs": [{ "name": "success", "type": "bool" }],
      "visibility": "public",
      "mutability": "mutable",
      "selector": "0x23b872dd",
      "description": "Transfer from approved allowance",
      "gas_estimate": 65000
    }
  ],
  "events": [
    {
      "name": "Transfer",
      "inputs": [
        { "name": "from", "type": "address", "indexed": true },
        { "name": "to", "type": "address", "indexed": true },
        { "name": "value", "type": "u256", "indexed": false }
      ],
      "topic": "0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef"
    },
    {
      "name": "Approval",
      "inputs": [
        { "name": "owner", "type": "address", "indexed": true },
        { "name": "spender", "type": "address", "indexed": true },
        { "name": "value", "type": "u256", "indexed": false }
      ],
      "topic": "0x8c5be1e5ebec7d5bd14f71427d1e84f3dd0314c0f7b2291e5b200ac8c7c3b925"
    }
  ],
  "errors": [
    {
      "name": "InsufficientBalance",
      "inputs": [
        { "name": "available", "type": "u256" },
        { "name": "required", "type": "u256" }
      ],
      "selector": "0x00000001"
    },
    {
      "name": "InsufficientAllowance",
      "inputs": [
        { "name": "available", "type": "u256" },
        { "name": "required", "type": "u256" }
      ],
      "selector": "0x00000002"
    },
    {
      "name": "InvalidRecipient",
      "inputs": [],
      "selector": "0x00000003"
    }
  ],
  "safety": {
    "audited": false,
    "max_gas": 200000,
    "deterministic": true,
    "atomic_capable": true,
    "cross_vm": []
  }
}
