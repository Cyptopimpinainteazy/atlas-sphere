// crates/x3-parser/src/tokens.rs
use x3_lexer::token::Token; // assume your lexer crate provides this
use std::iter::Peekable;
use std::vec::IntoIter;

pub struct TokenStream {
    iter: Peekable<IntoIter<Token>>,
    index: usize,
}

impl TokenStream {
    pub fn from_tokens(tokens: Vec<Token>) -> Self {
        Self { iter: tokens.into_iter().peekable(), index: 0 }
    }

    pub fn peek(&mut self) -> Option<&Token> {
        self.iter.peek()
    }

    pub fn peek_n(&mut self, n: usize) -> Option<&Token> {
        let mut clone = self.iter.clone();
        for _ in 0..(n-1) { clone.next(); }
        clone.peek()
    }

    pub fn next(&mut self) -> Option<Token> {
        let t = self.iter.next();
        if t.is_some() { self.index += 1; }
        t
    }

    pub fn expect(&mut self, expected_kind: x3_lexer::token::TokenKind) -> Result<Token, crate::error::ParseError> {
        if let Some(tok) = self.next() {
            if tok.kind == expected_kind {
                Ok(tok)
            } else {
                Err(crate::error::ParseError::new(crate::error::ParseErrorKind::UnexpectedToken(format!("{:?}", tok.kind)), tok.span.start))
            }
        } else {
            Err(crate::error::ParseError::new(crate::error::ParseErrorKind::UnexpectedEof, 0))
        }
    }

    pub fn index(&self) -> usize { self.index }
}
