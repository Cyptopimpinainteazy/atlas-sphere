// compiler/src/emit_from_mir.rs
use crate::mir::*;
use crate::regalloc::*;
use crate::emitter::{BytecodeBuilder}; // assume you have an emitter module

pub fn emit_program(mir: &MIRProgram) -> Vec<u8> {
    let mut bb = BytecodeBuilder::new();
    // write header later
    for (fi, func) in mir.funcs.iter().enumerate() {
        let mut f = func.clone();
        // run regalloc
        let mapping = linear_scan_alloc(&mut f);
        // emit blocks and instructions
        for blk in &f.cfg {
            for instr in &blk.instrs {
                emit_instr(instr, &mapping, &mut bb, &mir.const_pool);
            }
        }
    }
    bb.finish()
}

fn emit_instr(i: &Instr, mapping: &std::collections::HashMap<crate::mir::Temp,u8>, bb: &mut BytecodeBuilder, const_pool: &Vec<crate::mir::MirConst>) {
    match i {
        Instr::Add { dst, a, b } => {
            let rd = mapping.get(dst).cloned().unwrap();
            let ra = mapping.get(a).cloned().unwrap();
            let rb = mapping.get(b).cloned().unwrap();
            bb.emit_opcode(0x07);
            bb.emit_reg(rd);
            bb.emit_reg(ra);
            bb.emit_reg(rb);
        }
        Instr::Const { dst, val_idx } => {
            let rd = mapping.get(dst).cloned().unwrap();
            bb.emit_opcode(0x11); // LOAD_CONST
            bb.emit_reg(rd);
            bb.emit_u32(*val_idx as u32);
        }
        Instr::Call { dst, func_idx, args } => {
            let arg_regs: Vec<u8> = args.iter().map(|t| mapping.get(t).cloned().unwrap()).collect();
            bb.emit_opcode(0x09); // CALL_FUNC
            bb.emit_u32(*func_idx as u32);
            bb.emit_u8(arg_regs.len() as u8);
            for r in arg_regs { bb.emit_reg(r); }
            if let Some(d) = dst {
                let rd = mapping.get(d).cloned().unwrap();
                // ABI: function return placed into rd by runtime
                bb.emit_reg(rd);
            } else {
                bb.emit_reg(0xff); // no dest
            }
        }
        _ => {
            // expand more opcases
            unimplemented!("emit {:?}", i)
        }
    }
}
