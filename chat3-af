// compiler/src/regalloc.rs
use crate::mir::*;
use std::collections::{HashMap, HashSet};

/// Simple deterministic linear-scan allocator for temps -> physical registers R0..R31
pub fn linear_scan_alloc(func: &mut MIRFunction) -> HashMap<Temp, u8> {
    // Compute live ranges (very naive: each temp first/last instruction index)
    let mut first: HashMap<Temp, usize> = HashMap::new();
    let mut last: HashMap<Temp, usize> = HashMap::new();
    let mut idx = 0usize;
    for blk in &func.cfg {
        for instr in &blk.instrs {
            let uses = instr_uses(instr);
            for t in uses {
                if !first.contains_key(&t) { first.insert(t, idx); }
                last.insert(t, idx);
            }
            let defs = instr_defs(instr);
            for t in defs {
                if !first.contains_key(&t) { first.insert(t, idx); }
                last.insert(t, idx);
            }
            idx += 1;
        }
    }
    // Create list of temps sorted by first
    let mut temps: Vec<(Temp, usize)> = first.iter().map(|(t,i)| (*t,*i)).collect();
    temps.sort_by_key(|x| x.1);
    let mut active: Vec<(Temp, usize)> = Vec::new();
    let mut mapping: HashMap<Temp, u8> = HashMap::new();
    let mut free_regs: Vec<u8> = (0..32).map(|x| x as u8).collect();
    for (t, start) in temps {
        // expire old
        active.retain(|(at, end)| {
            if *end < start {
                // free its reg
                if let Some(r) = mapping.get(at) { free_regs.push(*r); }
                false
            } else { true }
        });
        // allocate
        if let Some(r) = free_regs.pop() {
            mapping.insert(t, r);
            let end = *last.get(&t).unwrap();
            active.push((t, end));
            // keep active sorted by end ascending
            active.sort_by_key(|x| x.1);
        } else {
            // spill - pick active with max end
            let (spill_temp, _) = active.iter().max_by_key(|x| x.1).unwrap().clone();
            // assign its register to current temp (simulate spill)
            let r = mapping.get(&spill_temp).cloned().unwrap();
            mapping.insert(t, r);
            mapping.remove(&spill_temp);
            // replace active entry
            active.retain(|(a,_)| a != &spill_temp);
            let end = *last.get(&t).unwrap();
            active.push((t, end));
            active.sort_by_key(|x| x.1);
        }
    }
    mapping
}

fn instr_uses(i: &Instr) -> Vec<Temp> {
    match i {
        Instr::Add {a, b, ..} => vec![*a, *b],
        Instr::Sub {a, b, ..} => vec![*a,*b],
        Instr::Mul {a, b, ..} => vec![*a,*b],
        Instr::Div {a, b, ..} => vec![*a,*b],
        Instr::Call { args, .. } => args.clone(),
        Instr::CondJump { cond, .. } => vec![*cond],
        Instr::Return { src } => src.map(|t| vec![t]).unwrap_or_default(),
        Instr::Const { .. } => vec![],
        Instr::Move { src, .. } => vec![*src],
        Instr::HostCall { args, .. } => args.clone(),
        _ => vec![]
    }
}

fn instr_defs(i: &Instr) -> Vec<Temp> {
    match i {
        Instr::Add { dst, ..} => vec![*dst],
        Instr::Sub { dst, ..} => vec![*dst],
        Instr::Mul { dst, ..} => vec![*dst],
        Instr::Div { dst, ..} => vec![*dst],
        Instr::Call { dst, .. } => dst.map(|t| vec![t]).unwrap_or_default(),
        Instr::Const { dst, .. } => vec![*dst],
        Instr::Move { dst, .. } => vec![*dst],
        Instr::HostCall { dst, .. } => dst.map(|t| vec![t]).unwrap_or_default(),
        _ => vec![]
    }
}
This allocator is deterministic and fast — good enough for initial codegen and sidecar JIT mapping. Replace spills with stack-slot emission later.

