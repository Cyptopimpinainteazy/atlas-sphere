// compiler/src/lower_hir_to_mir.rs
use crate::hir::*;
use crate::mir::*;

pub struct MirBuilder {
    next_temp: usize,
    next_block: usize,
    const_pool: Vec<MirConst>,
}

impl MirBuilder {
    pub fn new() -> Self {
        Self {
            next_temp: 0,
            next_block: 0,
            const_pool: Vec::new(),
        }
    }

    fn fresh_temp(&mut self) -> Temp { let t = Temp(self.next_temp); self.next_temp += 1; t }

    pub fn lower_program(&mut self, h: HIRProgram) -> MIRProgram {
        let mut funcs = Vec::new();
        for f in h.funcs {
            funcs.push(self.lower_func(f));
        }
        MIRProgram {
            funcs,
            const_pool: self.const_pool.clone(),
        }
    }

    fn lower_func(&mut self, f: HIRFunction) -> MIRFunction {
        // single-block straightline for now
        let mut block = BasicBlock { id: self.next_block, instrs: vec![], succ: vec![] };
        self.next_block += 1;
        for stmt in f.body {
            self.lower_stmt(&mut block, stmt);
        }
        block.instrs.push(Instr::Return { src: None });
        MIRFunction { name: f.name, cfg: vec![block], entry: 0, params: f.params.len() }
    }

    fn lower_stmt(&mut self, block: &mut BasicBlock, s: HIRStmt) {
        match s {
            HIRStmt::Assign(name, expr) => {
                // evaluate expr -> temp, move to local slot if needed
                let tmp = self.lower_expr(block, expr);
                // do a Move to a temp reserved for variable (skip var table mapping for prototype)
                block.instrs.push(Instr::Move { dst: tmp, src: tmp });
            }
            HIRStmt::Expr(e) => { self.lower_expr(block, e); }
            HIRStmt::Return(opt) => {
                let t = opt.map(|e| self.lower_expr(block, e));
                block.instrs.push(Instr::Return { src: t });
            }
            HIRStmt::If(cond, then_b, else_b) => {
                let ctmp = self.lower_expr(block, cond);
                let then_id = self.next_block; self.next_block += 1;
                let else_id = self.next_block; self.next_block += 1;
                let after_id = self.next_block; self.next_block += 1;
                // Add cond jump
                block.instrs.push(Instr::CondJump { cond: ctmp, t: then_id, f: else_id });
                // stub succs
                block.succ.push(then_id); block.succ.push(else_id);
                // build then block
                // (for prototype we won't actually create blocks content)
            }
        }
    }

    fn lower_expr(&mut self, block: &mut BasicBlock, e: HIRExpr) -> Temp {
        match e {
            HIRExpr::Const(idx) => {
                let dst = self.fresh_temp();
                block.instrs.push(Instr::Const { dst, val_idx: idx });
                dst
            }
            HIRExpr::Local(name) => {
                // naive: create temp representing local load
                let dst = self.fresh_temp();
                // in a real impl we map locals -> stack slots / temps
                dst
            }
            HIRExpr::BinOp(op, a, b) => {
                let ta = self.lower_expr(block, *a);
                let tb = self.lower_expr(block, *b);
                let dst = self.fresh_temp();
                match op.as_str() {
                    "+" => block.instrs.push(Instr::Add { dst, a: ta, b: tb }),
                    "-" => block.instrs.push(Instr::Sub { dst, a: ta, b: tb }),
                    "*" => block.instrs.push(Instr::Mul { dst, a: ta, b: tb }),
                    "/" => block.instrs.push(Instr::Div { dst, a: ta, b: tb }),
                    _ => unimplemented!(),
                }
                dst
            }
            HIRExpr::Call(name, args) => {
                let mut arg_temps = Vec::new();
                for a in args { arg_temps.push(self.lower_expr(block, a)); }
                let dst = self.fresh_temp();
                // Resolve function index elsewhere; use 0 for prototype
                block.instrs.push(Instr::Call { dst: Some(dst), func_idx: 0usize, args: arg_temps });
                dst
            }
        }
    }
}
