use thiserror::Error;

/// Basic structured errors for the verifier
#[derive(Debug, Error)]
pub enum VerifierError {
    #[error("empty bytecode")]
    Empty,
    #[error("bad header: {0}")]
    BadHeader(String),
    #[error("invalid opcode 0x{0:x} at offset {1}")]
    InvalidOpcode(u8, usize),
    #[error("operand out of range at offset {0}")]
    OperandOOB(usize),
    #[error("jump target OOB at offset {0}")]
    JumpTargetOOB(usize),
    #[error("unaligned jump target {0}")]
    JumpTargetUnaligned(usize),
    #[error("unbalanced atomic markers")]
    AtomicMarkersUnbalanced,
    #[error("const pool index OOB {0}")]
    ConstPoolOOB(usize),
    #[error("forbidden opcode in on-chain context: 0x{0:x}")]
    ForbiddenOpcode(u8),
    #[error("gas upper bound exceeded limit")]
    GasBoundExceeded,
    #[error("semantic error: {0}")]
    Semantic(String),
}

/// Lightweight representation of a decoded instruction
#[derive(Debug, Clone)]
pub struct DecodedInstr {
    pub opcode: u8,
