// crates/x3-parser/src/parser.rs
//! Pratt-style expression parser + statement parser for X3
use crate::tokens::TokenStream;
use crate::error::{ParseError, ParseErrorKind};
use x3_ast::ast::*;
use x3_lexer::token::{Token, TokenKind};
use std::collections::HashMap;

/// Public API: parse source tokens into AST::Program
pub fn parse_program_from_tokens(tokens: Vec<Token>) -> Result<Program, ParseError> {
    let mut ts = TokenStream::from_tokens(tokens);
    let mut items: Vec<Item> = Vec::new();

    while let Some(tok) = ts.peek() {
        // if EOF token type exists break; otherwise process until iter empty
        // Parse item
        if is_keyword(&tok, "fn") {
            let func = parse_function(&mut ts)?;
            items.push(Item::Func(func));
            continue;
        }
        // fallback: try parse top-level statement or import/const
        if is_keyword(&tok, "import") {
            // simple import handling
            ts.next();
            let s = expect_string_literal(&mut ts)?;
            // consume semicolon
            ts.expect(TokenKind::Semicolon)?;
            items.push(Item::Import(s));
            continue;
        }
        // try top-level stmt
        let stmt = parse_stmt(&mut ts)?;
        items.push(Item::Stmt(stmt));
    }

    Ok(Program { items })
}

/// Helper: is token a specific keyword
fn is_keyword(tok: &Token, s: &str) -> bool {
    matches!(tok.kind, TokenKind::Ident(_)) && tok.lexeme == s
}

/// Parse a function declaration
fn parse_function(ts: &mut TokenStream) -> Result<Func, ParseError> {
    // expect "fn"
    let fn_tok = ts.next().ok_or(ParseError::new(ParseErrorKind::UnexpectedEof, ts.index()))?;
    // name
    let name_tok = ts.next().ok_or(ParseError::new(ParseErrorKind::UnexpectedEof, ts.index()))?;
    let name = match &name_tok.kind {
        TokenKind::Ident(n) => n.clone(),
        _ => return Err(ParseError::new(ParseErrorKind::UnexpectedToken(format!("{:?}", name_tok.kind)), name_tok.span.start))
    };
    // expect "("
    ts.expect(TokenKind::LParen)?;
    // parse params (simplified)
    let mut params = Vec::new();
    while let Some(t) = ts.peek() {
        if matches!(t.kind, TokenKind::RParen) { ts.next(); break; }
        // identifier
        let id = ts.next().ok_or(ParseError::new(ParseErrorKind::UnexpectedEof, ts.index()))?;
        if let TokenKind::Ident(pn) = id.kind {
            params.push(pn);
        } else {
            return Err(ParseError::new(ParseErrorKind::UnexpectedToken(format!("{:?}", id.kind)), id.span.start));
        }
        // optional comma
        if let Some(c) = ts.peek() {
            if matches!(c.kind, TokenKind::Comma) { ts.next(); continue; }
        }
    }

    // optional return type omitted for brevity
    // parse body
    let body = parse_block(ts)?;
    Ok(Func { name, params, body })
}

/// Parse a block `{ ... }`
fn parse_block(ts: &mut TokenStream) -> Result<Block, ParseError> {
    ts.expect(TokenKind::LBrace)?;
    let mut stmts = Vec::new();
    while let Some(t) = ts.peek() {
        if matches!(t.kind, TokenKind::RBrace) { ts.next(); break; }
        let s = parse_stmt(ts)?;
        stmts.push(s);
    }
    Ok(Block { stmts })
}

/// Parse statement
pub fn parse_stmt(ts: &mut TokenStream) -> Result<Stmt, ParseError> {
    if let Some(tok) = ts.peek() {
        match &tok.kind {
            TokenKind::Ident(ref s) if s == "let" => {
                ts.next(); // consume let
                let name_tok = ts.next().ok_or(ParseError::new(ParseErrorKind::UnexpectedEof, ts.index()))?;
                let name = match &name_tok.kind { TokenKind::Ident(n) => n.clone(), _ => return Err(ParseError::new(ParseErrorKind::UnexpectedToken(format!("{:?}", name_tok.kind)), name_tok.span.start)) };
                // optional type, optional initializer
                ts.expect(TokenKind::Equal)?;
                let expr = parse_expression(ts, 0)?;
                ts.expect(TokenKind::Semicolon)?;
                Ok(Stmt::Let(name, expr))
            }
            TokenKind::Ident(ref s) if s == "return" => {
                ts.next();
                let maybe_expr = if let Some(nxt) = ts.peek() {
                    if !matches!(nxt.kind, TokenKind::Semicolon) {
                        Some(parse_expression(ts, 0)?)
                    } else { None }
                } else { None };
                ts.expect(TokenKind::Semicolon)?;
                Ok(Stmt::Return(maybe_expr))
            }
            TokenKind::Ident(ref s) if s == "atomic" => {
                // parse atomic block
                ts.next();
                let block = parse_block(ts)?;
                Ok(Stmt::Atomic(block))
            }
            _ => {
                // expression statement
                let e = parse_expression(ts, 0)?;
                ts.expect(TokenKind::Semicolon)?;
                Ok(Stmt::Expr(e))
            }
        }
    } else {
        Err(ParseError::new(ParseErrorKind::UnexpectedEof, ts.index()))
    }
}

/// Top-level Pratt expression parser
/// `min_bp` is minimum binding power to continue parsing
pub fn parse_expression(ts: &mut TokenStream, min_bp: u8) -> Result<Expr, ParseError> {
    // Read prefix / primary
    let mut lhs = match ts.next() {
        Some(tok) => match tok.kind {
            TokenKind::IntLiteral(i) => Expr::Literal(Literal::Integer(i)),
            TokenKind::HexLiteral(s) => Expr::Literal(Literal::Hex(s)),
            TokenKind::StringLiteral(s) => Expr::Literal(Literal::String(s)),
            TokenKind::Ident(name) => Expr::Ident(name),
            TokenKind::LParen => {
                let e = parse_expression(ts, 0)?;
                ts.expect(TokenKind::RParen)?;
                e
            }
            TokenKind::Bang => {
                // prefix not
                let rhs = parse_expression(ts, PREFIX_BP)?;
                Expr::Unary(UnaryOp::Not, Box::new(rhs))
            }
            TokenKind::Minus => {
                let rhs = parse_expression(ts, PREFIX_BP)?;
                Expr::Unary(UnaryOp::Neg, Box::new(rhs))
            }
            other => return Err(ParseError::new(ParseErrorKind::UnexpectedToken(format!("{:?}", other)), tok.span.start))
        },
        None => return Err(ParseError::new(ParseErrorKind::UnexpectedEof, ts.index()))
    };

    loop {
        // peek next token to decide infix / postfix
        let op = if let Some(t) = ts.peek() { t.clone() } else { break; };

        // determine binding power and associativity
        if let Some((left_bp, right_bp)) = infix_binding_power(&op.kind) {
            if left_bp < min_bp { break; }
            // consume operator
            let _op_tok = ts.next().unwrap();
            // parse right-hand side with right_bp
            let rhs = parse_expression(ts, right_bp)?;
            lhs = match &op.kind {
                TokenKind::Plus => Expr::Binary(BinaryOp::Add, Box::new(lhs), Box::new(rhs)),
                TokenKind::Minus => Expr::Binary(BinaryOp::Sub, Box::new(lhs), Box::new(rhs)),
                TokenKind::Star => Expr::Binary(BinaryOp::Mul, Box::new(lhs), Box::new(rhs)),
                TokenKind::Slash => Expr::Binary(BinaryOp::Div, Box::new(lhs), Box::new(rhs)),
                TokenKind::DoubleAmp => Expr::Binary(BinaryOp::And, Box::new(lhs), Box::new(rhs)),
                TokenKind::DoublePipe => Expr::Binary(BinaryOp::Or, Box::new(lhs), Box::new(rhs)),
                TokenKind::EqualEqual => Expr::Binary(BinaryOp::Eq, Box::new(lhs), Box::new(rhs)),
                TokenKind::BangEqual => Expr::Binary(BinaryOp::Neq, Box::new(lhs), Box::new(rhs)),
                TokenKind::Less => Expr::Binary(BinaryOp::Lt, Box::new(lhs), Box::new(rhs)),
                TokenKind::Greater => Expr::Binary(BinaryOp::Gt, Box::new(lhs), Box::new(rhs)),
                _ => return Err(ParseError::new(ParseErrorKind::UnexpectedToken(format!("{:?}", op.kind)), op.span.start))
            };
            continue;
        }

        // Postfix / call / index / field handling
        if let Some((post_bp, _)) = postfix_binding_power(&op.kind) {
            if post_bp < min_bp { break; }
            // handle call
            match &op.kind {
                TokenKind::LParen => {
                    // consume '('
                    ts.next();
                    let mut args = Vec::new();
                    if let Some(nxt) = ts.peek() {
                        if !matches!(nxt.kind, TokenKind::RParen) {
                            loop {
                                let a = parse_expression(ts, 0)?;
                                args.push(a);
                                if let Some(c) = ts.peek() {
                                    if matches!(c.kind, TokenKind::Comma) { ts.next(); continue; }
                                    else { break; }
                                } else { break; }
                            }
                        }
                    }
                    ts.expect(TokenKind::RParen)?;
                    lhs = Expr::Call(Box::new(lhs), args);
                    continue;
                }
                TokenKind::Dot => {
                    ts.next(); // consume dot
                    let fld = ts.next().ok_or(ParseError::new(ParseErrorKind::UnexpectedEof, ts.index()))?;
                    if let TokenKind::Ident(name) = fld.kind {
                        lhs = Expr::FieldAccess(Box::new(lhs), name);
                        continue;
                    } else {
                        return Err(ParseError::new(ParseErrorKind::UnexpectedToken(format!("{:?}", fld.kind)), fld.span.start));
                    }
                }
                TokenKind::LBracket => {
                    ts.next(); // consume '['
                    let idx = parse_expression(ts, 0)?;
                    ts.expect(TokenKind::RBracket)?;
                    lhs = Expr::Index(Box::new(lhs), Box::new(idx));
                    continue;
                }
                _ => {}
            }
        }

        break;
    }

    Ok(lhs)
}

/// Binding power lookup for infix
/// Return Some((left_bp, right_bp)) if token is infix with those strengths.
fn infix_binding_power(kind: &TokenKind) -> Option<(u8,u8)> {
    use TokenKind::*;
    match kind {
        DoublePipe => Some((30, 31)),
        DoubleAmp => Some((35, 36)),
        Plus | Minus => Some((90, 91)),
        Star | Slash | Percent => Some((100, 101)),
        EqualEqual | BangEqual => Some((60, 61)),
        Less | Greater | LessEq | GreaterEq => Some((70, 71)),
        _ => None
    }
}

/// Postfix bindings for calls/field/index (higher precedence)
fn postfix_binding_power(kind: &TokenKind) -> Option<(u8,u8)> {
    use TokenKind::*;
    match kind {
        LParen | Dot | LBracket => Some((120, 121)),
        _ => None
    }
}

/// constant for prefix binding power used above
const PREFIX_BP: u8 = 110;

