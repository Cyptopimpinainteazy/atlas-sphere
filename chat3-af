#[derive(Debug, Error)]
pub enum ParseErrorKind {
    #[error("unexpected token: {0}")]
    UnexpectedToken(String),
    #[error("unexpected EOF")]
    UnexpectedEof,
    #[error("invalid literal")]
    InvalidLiteral,
    #[error("unbalanced atomic block")]
    UnbalancedAtomic,
    #[error("semantic error: {0}")]
    Semantic(String),
}

#[derive(Debug)]
pub struct ParseError {
    pub kind: ParseErrorKind,
    pub pos: usize, // offset in source; keep simple deterministic position
}

impl ParseError {
    pub fn new(kind: ParseErrorKind, pos: usize) -> Self { Self { kind, pos } }
}

impl fmt::Display for ParseError {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        write!(f, "ParseError@{}: {}", self.pos, self.kind)
    }
}
