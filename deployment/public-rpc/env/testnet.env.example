# Example env for a public testnet RPC node
# Copy to: /etc/atlas-sphere/rpc/testnet.env

# For a clean separation (recommended), see also:
# - deployment/public-rpc/env/testnet-public.env.example
# - deployment/public-rpc/env/testnet-ops.env.example

# If you run multiple RPC nodes on the same host (dev/local/staging/testnet),
# ensure each instance uses a unique base_path and unique ports.

node_name=atlas-rpc-testnet-01
base_path=/var/lib/atlas-sphere/rpc-testnet
chain=testnet
chain_spec_dir=deployment/chain-specs

rpc_port=9944
p2p_port=30333
prometheus_port=9615

# Recommended: keep node RPC on localhost and expose via nginx.
rpc_bind=localhost

# Optional (browser access). Prefer an allowlist if possible.
# rpc_cors=https://explorer.atlas-sphere.io,https://dex.atlas-sphere.io
rpc_methods=Safe

# Optional tuning for tighter limits
# rpc_max_connections=300
# rpc_max_request_size_mb=10
# rpc_max_response_size_mb=50
# rpc_max_subscriptions_per_connection=20

# Optional: enforce an explicit "yes" when rpc_bind=public
# require_confirm_public_rpc=true
# confirm_public_rpc=yes

# node_bin=/usr/local/bin/atlas-sphere-node
node_bin=./target/release/atlas-sphere-node
