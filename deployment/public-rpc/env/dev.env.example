# Example env for a dev RPC node
# Copy to: /etc/atlas-sphere/rpc/dev.env

# For a clean separation (recommended), see also:
# - deployment/public-rpc/env/dev-public.env.example
# - deployment/public-rpc/env/dev-ops.env.example

# If you run multiple RPC nodes on the same host (dev/local/staging/testnet),
# ensure each instance uses a unique base_path and unique ports.

node_name=atlas-rpc-dev
base_path=/var/lib/atlas-sphere/rpc-dev
chain=dev

rpc_port=9944
p2p_port=30333
prometheus_port=9615

# Dev-only: can be 'public' if you really want direct exposure.
rpc_bind=localhost

# Optional (browser access). Prefer an allowlist instead of 'all'.
# rpc_cors=http://localhost:3000,http://localhost:3001

# Prefer Safe even in dev; only use Unsafe if you truly need it.
rpc_methods=Safe

# Optional tuning for tighter limits
# rpc_max_connections=200
# rpc_max_request_size_mb=10
# rpc_max_response_size_mb=50
# rpc_max_subscriptions_per_connection=20

node_bin=./target/release/atlas-sphere-node
