# Example env for an INTERNAL ops/debug staging RPC node (admin / unsafe)
# Copy to: /etc/atlas-sphere/rpc/staging-ops.env
# Start via: systemctl enable --now atlas-sphere-rpc@staging-ops
#
# This instance is NOT meant to be exposed publicly.
# Access it via SSH port forwarding or a private network.

# If you run multiple RPC nodes on the same host, ensure unique base_path + ports.

node_name=atlas-rpc-staging-ops-01
base_path=/var/lib/atlas-sphere/rpc-staging-ops
chain=staging
chain_spec_dir=deployment/chain-specs

# Bind to a DIFFERENT localhost-only port than the public instance.
rpc_port=9955

# P2P and prometheus ports must be unique per instance
p2p_port=30344
prometheus_port=9626

# Keep RPC local only.
rpc_bind=localhost

# Ops instance can run Unsafe methods (do not expose to Internet).
rpc_methods=Unsafe

# Strongly recommend disabling browser CORS here.
# rpc_cors=

# Optional tuning for tighter limits
# rpc_max_connections=100
# rpc_max_request_size_mb=10
# rpc_max_response_size_mb=50
# rpc_max_subscriptions_per_connection=10

node_bin=./target/release/atlas-sphere-node
