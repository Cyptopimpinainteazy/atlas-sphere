# Example env for a PUBLIC testnet RPC node (read-only / safe)
# Copy to: /etc/atlas-sphere/rpc/testnet-public.env
# Start via: systemctl enable --now atlas-sphere-rpc@testnet-public
#
# This instance is intended to sit behind nginx (TLS + rate limiting + allowlist).
# Keep node RPC bound to localhost.

# If you run multiple RPC nodes on the same host, ensure unique base_path + ports.

node_name=atlas-rpc-testnet-public-01
base_path=/var/lib/atlas-sphere/rpc-testnet-public
chain=testnet
chain_spec_dir=deployment/chain-specs

# Public RPC listens here (nginx upstream should point to this)
rpc_port=9944

# P2P and prometheus ports must be unique per instance
p2p_port=30333
prometheus_port=9615

# Recommended: keep node RPC on localhost and expose via nginx.
rpc_bind=localhost

# Prefer Safe methods for any public exposure.
rpc_methods=Safe

# Optional (browser access). Prefer an allowlist if possible.
# rpc_cors=https://explorer.x3,https://dex.x3

# Optional tuning for tighter limits
# rpc_max_connections=300
# rpc_max_request_size_mb=10
# rpc_max_response_size_mb=50
# rpc_max_subscriptions_per_connection=20

node_bin=./target/release/atlas-sphere-node
