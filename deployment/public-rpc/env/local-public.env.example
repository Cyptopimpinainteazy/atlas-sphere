# Example env for a PUBLIC local RPC node (read-only / safe)
# Copy to: /etc/atlas-sphere/rpc/local-public.env
# Start via: systemctl enable --now atlas-sphere-rpc@local-public
#
# This instance is intended to sit behind nginx (TLS + rate limiting + allowlist).
# Keep node RPC bound to localhost.

# If you run multiple RPC nodes on the same host, ensure unique base_path + ports.

node_name=atlas-rpc-local-public-01
base_path=/var/lib/atlas-sphere/rpc-local-public
chain=local

# Public RPC listens here (nginx upstream should point to this)
rpc_port=9964

# P2P and prometheus ports must be unique per instance
p2p_port=30353
prometheus_port=9635

rpc_bind=localhost
rpc_methods=Safe

# Optional tuning for tighter limits
# rpc_max_connections=300
# rpc_max_request_size_mb=10
# rpc_max_response_size_mb=50
# rpc_max_subscriptions_per_connection=20

node_bin=./target/release/atlas-sphere-node
