# Example env for a local testnet RPC node
# Copy to: /etc/atlas-sphere/rpc/local.env

# For a clean separation (recommended), see also:
# - deployment/public-rpc/env/local-public.env.example
# - deployment/public-rpc/env/local-ops.env.example

# If you run multiple RPC nodes on the same host (dev/local/staging/testnet),
# ensure each instance uses a unique base_path and unique ports.

node_name=atlas-rpc-local-01
base_path=/var/lib/atlas-sphere/rpc-local
chain=local

rpc_port=9944
p2p_port=30333
prometheus_port=9615

rpc_bind=localhost
rpc_methods=Safe

# Optional tuning for tighter limits
# rpc_max_connections=300
# rpc_max_request_size_mb=10
# rpc_max_response_size_mb=50
# rpc_max_subscriptions_per_connection=20

# Optional: enforce an explicit "yes" when rpc_bind=public
# require_confirm_public_rpc=true
# confirm_public_rpc=yes

node_bin=./target/release/atlas-sphere-node
