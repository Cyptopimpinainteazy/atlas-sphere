[Unit]
Description=Atlas Sphere RPC Node (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=atlas
Group=atlas

# Instance env file (create one per network):
# - /etc/atlas-sphere/rpc/dev.env
# - /etc/atlas-sphere/rpc/local.env
# - /etc/atlas-sphere/rpc/staging.env
# - /etc/atlas-sphere/rpc/testnet.env
EnvironmentFile=/etc/atlas-sphere/rpc/%i.env

# Keep RPC node stable.
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

# Run from the repo checkout or adjust node_bin in the env file.
WorkingDirectory=/opt/atlas-sphere
ExecStart=/opt/atlas-sphere/deployment/public-rpc/run-public-rpc.sh

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true

# No special capabilities required.
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/atlas-sphere

[Install]
WantedBy=multi-user.target
