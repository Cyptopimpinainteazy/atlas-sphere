[Unit]
Description=Atlas Sphere Cross-Chain GPU Validator
Documentation=man:ccgv(1)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=atlas
WorkingDirectory=/home/atlas/atlas-sphere/cross-chain-gpu-validator
ExecStart=/home/atlas/atlas-sphere/cross-chain-gpu-validator/.venv/bin/python -m cross_chain_gpu_validator.cli serve --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
Environment="PATH=/home/atlas/atlas-sphere/cross-chain-gpu-validator/.venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONUNBUFFERED=1"
Environment="CCGV_REDIS_HOST=localhost"
Environment="CCGV_REDIS_PORT=6379"
Environment="CCGV_LOG_LEVEL=INFO"

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/log/atlas /var/lib/atlas

[Install]
WantedBy=multi-user.target
