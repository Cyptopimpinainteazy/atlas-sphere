[Unit]
Description=Atlas Sphere X3 Intelligence Dashboard
Documentation=man:x3-intelligence(1)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=atlas
WorkingDirectory=/home/atlas/atlas-sphere/apps/x3-intelligence
ExecStart=/usr/bin/npm run start
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
Environment="NODE_ENV=production"
Environment="PORT=5173"
Environment="HOST=0.0.0.0"
Environment="AUTH_SALT=atlas-sphere-production-2026"
Environment="VITE_API_URL=http://localhost:8000"
Environment="PATH=/home/atlas/atlas-sphere/apps/x3-intelligence/node_modules/.bin:/usr/local/bin:/usr/bin:/bin"

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/log/atlas /tmp

[Install]
WantedBy=multi-user.target
