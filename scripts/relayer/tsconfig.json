{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["mocha", "node"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "test-runner.js"]
}
