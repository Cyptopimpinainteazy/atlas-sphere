// compiler/src/mir.rs
use std::collections::HashMap;

#[derive(Debug, Clone)]
pub struct MIRProgram {
    pub funcs: Vec<MIRFunction>,
    pub const_pool: Vec<MirConst>,
}

#[derive(Debug, Clone)]
pub struct MIRFunction {
    pub name: String,
    pub cfg: Vec<BasicBlock>,
    pub entry: usize,
    pub params: usize,
}

#[derive(Debug, Clone)]
pub struct BasicBlock {
    pub id: usize,
    pub instrs: Vec<Instr>,
    pub succ: Vec<usize>,
}

#[derive(Debug, Clone)]
pub enum Instr {
    // pure arithmetic
    Add { dst: Temp, a: Temp, b: Temp },
    Sub { dst: Temp, a: Temp, b: Temp },
    Mul { dst: Temp, a: Temp, b: Temp },
    Div { dst: Temp, a: Temp, b: Temp },

    // move/const
    Const { dst: Temp, val_idx: usize },
    Move { dst: Temp, src: Temp },

    // calls
    Call { dst: Option<Temp>, func_idx: usize, args: Vec<Temp> },

    // control
    Jump { target: usize },
    CondJump { cond: Temp, t: usize, f: usize },
    Return { src: Option<Temp> },

    // hostcall placeholder
    HostCall { dst: Option<Temp>, op: u8, args: Vec<Temp> },
}

#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
pub struct Temp(pub usize);
