use crate::consts::ConstValue;
use std::collections::HashMap;

#[derive(Debug, Clone)]
pub struct HIRProgram {
    pub funcs: Vec<HIRFunction>,
    pub const_pool: Vec<ConstValue>,
}

#[derive(Debug, Clone)]
pub struct HIRFunction {
    pub name: String,
    pub params: Vec<String>,
    pub locals: Vec<String>,
    pub body: Vec<HIRStmt>,
}

#[derive(Debug, Clone)]
pub enum HIRStmt {
    Assign(String, HIRExpr),
    Expr(HIRExpr),
    If(HIRExpr, Vec<HIRStmt>, Option<Vec<HIRStmt>>),
    Return(Option<HIRExpr>),
}

#[derive(Debug, Clone)]
pub enum HIRExpr {
    Const(usize),
    Local(String),
    Call(String, Vec<HIRExpr>),
    BinOp(String, Box<HIRExpr>, Box<HIRExpr>),
}
