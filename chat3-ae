// compiler/src/lowering.rs
use std::collections::HashMap;
use x3_ast::ast::*; // your AST types
use crate::hir::*;

pub struct Lowerer {
    pub func_index: HashMap<String, usize>,
    pub const_pool: Vec<ConstValue>,
}

impl Lowerer {
    pub fn new() -> Self {
        Self {
            func_index: HashMap::new(),
            const_pool: Vec::new(),
        }
    }

    pub fn lower_program(&mut self, prog: &Program) -> HIRProgram {
        let mut hir_funcs = Vec::new();
        for item in &prog.items {
            match item {
                Item::Func(f) => {
                    let idx = hir_funcs.len();
                    self.func_index.insert(f.name.clone(), idx);
                    let hf = self.lower_func(f);
                    hir_funcs.push(hf);
                }
                _ => { /* global consts, imports, etc. */ }
            }
        }
        HIRProgram { funcs: hir_funcs, const_pool: self.const_pool.clone() }
    }

    fn lower_func(&mut self, f: &Func) -> HIRFunction {
        // Name resolution for params/local variables, flatten statements, remove syntactic sugar
        let mut hir_body = Vec::new();
        for stmt in &f.body {
            let h = self.lower_stmt(stmt);
            hir_body.push(h);
        }
        HIRFunction {
            name: f.name.clone(),
            params: f.params.clone(),
            locals: Vec::new(),
            body: hir_body,
        }
    }

    fn lower_stmt(&mut self, s: &Stmt) -> HIRStmt {
        match s {
            Stmt::Let(name, expr) => {
                HIRStmt::Assign(name.clone(), self.lower_expr(expr))
            }
            Stmt::Expr(e) => HIRStmt::Expr(self.lower_expr(e)),
            Stmt::If(cond, then_block, else_block) => {
                HIRStmt::If(self.lower_expr(cond), then_block.iter().map(|st| self.lower_stmt(st)).collect(), else_block.as_ref().map(|b| b.iter().map(|st| self.lower_stmt(st)).collect()))
            }
            Stmt::Return(opt) => HIRStmt::Return(opt.as_ref().map(|e| self.lower_expr(e))),
            _ => unimplemented!("stmt {:?}", s),
        }
    }

    fn lower_expr(&mut self, e: &Expr) -> HIRExpr {
        match e {
            Expr::Literal(l) => {
                let idx = self.push_const(l.clone());
                HIRExpr::Const(idx)
            }
            Expr::Ident(name) => HIRExpr::Local(name.clone()),
            Expr::Call(name, args) => {
                let a = args.iter().map(|x| self.lower_expr(x)).collect();
                HIRExpr::Call(name.clone(), a)
            }
            Expr::Binary(op, a, b) => HIRExpr::BinOp(op.clone(), Box::new(self.lower_expr(a)), Box::new(self.lower_expr(b))),
            _ => unimplemented!("expr {:?}", e),
        }
    }

    fn push_const(&mut self, c: Literal) -> usize {
        let cv = ConstValue::from_literal(c);
        if let Some(i) = self.const_pool.iter().position(|x| x == &cv) {
            i
        } else {
            self.const_pool.push(cv);
            self.const_pool.len()-1
        }
    }
