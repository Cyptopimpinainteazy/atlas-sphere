{
  "Comit Transaction": {
    "prefix": "comit",
    "body": [
      "comit \"${1:transaction_name}\" {",
      "\tevm {",
      "\t\tcontract: \"${2:0x...}\",",
      "\t\tmethod: \"${3:functionName}\",",
      "\t\targs: [${4}],",
      "\t\tgas_limit: ${5:100000}",
      "\t}",
      "\tsvm {",
      "\t\tprogram: \"${6:program_id}\",",
      "\t\tinstruction: ${7:0},",
      "\t\taccounts: [${8}],",
      "\t\tcompute_units: ${9:200000}",
      "\t}",
      "}"
    ],
    "description": "Create a new Comit cross-VM transaction"
  },
  "EVM Only Comit": {
    "prefix": "evm_only",
    "body": [
      "comit \"${1:evm_tx}\" {",
      "\tevm {",
      "\t\tcontract: \"${2:0x...}\",",
      "\t\tmethod: \"${3:functionName}\",",
      "\t\targs: [${4}],",
      "\t\tgas_limit: ${5:100000},",
      "\t\tvalue: ${6:0}",
      "\t}",
      "}"
    ],
    "description": "Create an EVM-only Comit transaction"
  },
  "SVM Only Comit": {
    "prefix": "svm_only",
    "body": [
      "comit \"${1:svm_tx}\" {",
      "\tsvm {",
      "\t\tprogram: \"${2:program_id}\",",
      "\t\tinstruction: ${3:0},",
      "\t\taccounts: [",
      "\t\t\t{ pubkey: \"${4}\", is_signer: ${5:false}, is_writable: ${6:true} }",
      "\t\t],",
      "\t\tcompute_units: ${7:200000},",
      "\t\tdata: [${8}]",
      "\t}",
      "}"
    ],
    "description": "Create an SVM-only Comit transaction"
  },
  "EVM Payload": {
    "prefix": "evm",
    "body": [
      "evm {",
      "\tcontract: \"${1:0x...}\",",
      "\tmethod: \"${2:functionName}\",",
      "\targs: [${3}],",
      "\tgas_limit: ${4:100000}",
      "}"
    ],
    "description": "EVM execution payload"
  },
  "SVM Payload": {
    "prefix": "svm",
    "body": [
      "svm {",
      "\tprogram: \"${1:program_id}\",",
      "\tinstruction: ${2:0},",
      "\taccounts: [${3}],",
      "\tcompute_units: ${4:200000}",
      "}"
    ],
    "description": "SVM execution payload"
  },
  "Account Meta": {
    "prefix": "account",
    "body": [
      "{ pubkey: \"${1}\", is_signer: ${2:false}, is_writable: ${3:true} }"
    ],
    "description": "SVM account meta entry"
  },
  "Atomic Swap": {
    "prefix": "atomic_swap",
    "body": [
      "// Atomic cross-VM swap",
      "comit \"${1:atomic_swap}\" {",
      "\t// Lock tokens on EVM",
      "\tevm {",
      "\t\tcontract: \"${2:0x_lock_contract}\",",
      "\t\tmethod: \"lock\",",
      "\t\targs: [\"${3:amount}\", \"${4:recipient}\"],",
      "\t\tgas_limit: 150000",
      "\t}",
      "\t// Mint tokens on SVM",
      "\tsvm {",
      "\t\tprogram: \"${5:mint_program}\",",
      "\t\tinstruction: 0,",
      "\t\taccounts: [",
      "\t\t\t{ pubkey: \"${6:mint}\", is_signer: false, is_writable: true },",
      "\t\t\t{ pubkey: \"${7:destination}\", is_signer: false, is_writable: true }",
      "\t\t],",
      "\t\tcompute_units: 200000,",
      "\t\tdata: [${8}]",
      "\t}",
      "}"
    ],
    "description": "Atomic swap between EVM and SVM"
  }
}
