{
  "FRAME Pallet": {
    "prefix": "pallet",
    "body": [
      "#![cfg_attr(not(feature = \"std\"), no_std)]",
      "",
      "pub use pallet::*;",
      "",
      "#[frame_support::pallet]",
      "pub mod pallet {",
      "\tuse frame_support::pallet_prelude::*;",
      "\tuse frame_system::pallet_prelude::*;",
      "",
      "\t#[pallet::pallet]",
      "\tpub struct Pallet<T>(_);",
      "",
      "\t#[pallet::config]",
      "\tpub trait Config: frame_system::Config {",
      "\t\ttype RuntimeEvent: From<Event<Self>> + IsType<<Self as frame_system::Config>::RuntimeEvent>;",
      "\t}",
      "",
      "\t#[pallet::storage]",
      "\t#[pallet::getter(fn ${1:storage_name})]",
      "\tpub type ${2:StorageName}<T> = StorageValue<_, ${3:u32}, ValueQuery>;",
      "",
      "\t#[pallet::event]",
      "\t#[pallet::generate_deposit(pub(super) fn deposit_event)]",
      "\tpub enum Event<T: Config> {",
      "\t\t${4:SomethingStored} { value: ${5:u32}, who: T::AccountId },",
      "\t}",
      "",
      "\t#[pallet::error]",
      "\tpub enum Error<T> {",
      "\t\t${6:NoneValue},",
      "\t\t${7:StorageOverflow},",
      "\t}",
      "",
      "\t#[pallet::call]",
      "\timpl<T: Config> Pallet<T> {",
      "\t\t#[pallet::call_index(0)]",
      "\t\t#[pallet::weight(10_000)]",
      "\t\tpub fn ${8:do_something}(origin: OriginFor<T>, value: ${9:u32}) -> DispatchResult {",
      "\t\t\tlet who = ensure_signed(origin)?;",
      "\t\t\t${10:// Implementation}",
      "\t\t\tSelf::deposit_event(Event::${4:SomethingStored} { value, who });",
      "\t\t\tOk(())",
      "\t\t}",
      "\t}",
      "}"
    ],
    "description": "Create a new FRAME pallet boilerplate"
  },
