{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/schemas/tauri.conf.json",
  "productName": "Atlas Desktop",
  "version": "0.1.0",
  "identifier": "com.atlassphere.atlasdesktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Atlas Desktop",
        "width": 1400,
        "height": 900,
        "minWidth": 1200,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "visible": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' ws://localhost:5173 wss://localhost:5173 http://127.0.0.1:* https://127.0.0.1:* ws://127.0.0.1:* wss://127.0.0.1:*; worker-src 'self' blob:"
    },
    "trayIcon": null
  },
  "bundle": {
    "active": true,
    "targets": "all"
  },
  "plugins": {}
}
