{
  "name": "@atlas-sphere/apps/user-ecosystem",
  "version": "1.0.0",
  "private": true,
  "description": "Atlas Sphere User Ecosystem - Desktop, Browser Extension, Web Portal",
  "workspaces": [
    "packages/*",
    "desktop",
    "extension",
    "portal"
  ],
  "scripts": {
    "dev:desktop": "cd desktop && npm run tauri dev",
    "dev:extension": "cd extension && npm run dev",
    "dev:portal": "cd portal && npm run dev",
    "build:desktop": "cd desktop && npm run tauri build",
    "build:extension": "cd extension && npm run build",
    "build:portal": "cd portal && npm run build",
    "build:all": "npm run build:desktop && npm run build:extension && npm run build:portal",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\""
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "typescript": "^5.3.3"
  }
}
