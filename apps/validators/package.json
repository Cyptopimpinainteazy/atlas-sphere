{
  "name": "@x3-chain/validators",
  "version": "1.0.0",
  "type": "module",
  "description": "Validator network monitoring and analytics dashboard",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
