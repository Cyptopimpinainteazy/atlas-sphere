# 3ai Chain Configuration

# Chain RPC URLs
RPC_URL=http://localhost:8545
L1_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_KEY
L2_RPC_URL=http://localhost:8545

# Private Key (NEVER commit actual keys to git)
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Contract Addresses
CONTRACT_ADDRESS=0xYOUR_DEPLOYED_ORDERBOOK_CONTRACT

# Token Configuration
BASE_TOKEN=0x0000000000000000000000000000000000000000  # ETH
QUOTE_TOKEN=0x0000000000000000000000000000000000000000 # ETH

# Bridge Tokens (for cross-chain)
L1_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000  # ETH on L1
L2_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000  # ETH on L2
