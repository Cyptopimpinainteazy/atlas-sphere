# WebSocket
VITE_WS_URL=ws://localhost:3001

# Contract Addresses
VITE_ORDERBOOK_CONTRACT_ADDRESS=0x1234567890123456789012345678901234567890

# Add other environment variables below
# VITE_ANOTHER_VARIABLE=value
