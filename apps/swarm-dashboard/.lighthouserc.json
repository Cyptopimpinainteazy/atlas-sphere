{
  "extends": "@lighthouserc/config",
  "ci": {
    "collect": {
      "url": [
        "http://localhost:4173",
        "http://localhost:4173/gpu",
        "http://localhost:4173/tasks",
        "http://localhost:4173/network"
      ],
      "numberOfRuns": 3,
      "settings": {
        "configPath": "./apps/swarm-dashboard/.lighthouse/config.json",
        "emulatedFormFactor": "desktop"
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    },
    "assert": {
      "preset": "lighthouse:recommended",
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.6
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.85
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.8
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.85
          }
        ]
      }
    }
  }
}
