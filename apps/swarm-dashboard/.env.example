# GPU Swarm Dashboard - Environment Configuration
# Copy this file to .env.local and update the values

# API Base URL (Backend REST API)
VITE_API_BASE_URL=http://localhost:5000/api

# WebSocket Base URL (For real-time updates)
VITE_WS_BASE_URL=ws://localhost:5000/ws

# Optional: Enable debug logging
VITE_DEBUG=false

# Optional: Network name (for display purposes)
VITE_NETWORK_NAME=testnet
