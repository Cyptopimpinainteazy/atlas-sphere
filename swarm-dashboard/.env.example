# Example environment variables for swarm-dashboard
# Primary RPC used by the dashboard (overrides any fallback/public URL)
NEXT_PUBLIC_RPC_URL=http://localhost:9944

# Public RPC to use temporarily until testnet is available (will be used if NEXT_PUBLIC_RPC_URL is not set)
# Replace with a publicly accessible RPC endpoint provided by your provider
NEXT_PUBLIC_PUBLIC_RPC_URL=https://public-rpc.example.com

# Alternate fallback name (supported interchangeably with NEXT_PUBLIC_PUBLIC_RPC_URL)
NEXT_PUBLIC_FALLBACK_RPC_URL=

# Other env vars...
# NEXT_PUBLIC_ANALYTICS_KEY=
