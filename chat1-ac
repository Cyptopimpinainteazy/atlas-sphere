    use frame_system::pallet_prelude::*;
    
    #[pallet::config]
    pub trait Config: frame_system::Config {}
    
    #[pallet::pallet]
    #[pallet::generate_store(pub(super) trait Store)]
    pub struct Pallet<T>(_);

    #[pallet::storage]
    #[pallet::getter(fn receipts)]
    pub type Receipts<T: Config> = StorageMap<_, Blake2_128Concat, T::Hash, Vec<u8>, OptionQuery>;

    #[pallet::call]
    impl<T: Config> Pallet<T> {
        #[pallet::weight(10_000)]
        pub fn submit_receipt(origin: OriginFor<T>, receipt: Vec<u8>) -> DispatchResult {
            let sender = ensure_signed(origin)?;
            let hash = T::Hashing::hash(&receipt);
            <Receipts<T>>::insert(hash, receipt);
            Ok(())
        }
    }
}
