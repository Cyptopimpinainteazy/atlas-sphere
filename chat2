11 — VM loop pseudocode (interpreter)
function execute_function(func_idx, args, ctx):
    frame = new Frame(func_idx, locals_size)
    push_frame(frame)
    ip = func.offset
    while true:
        opcode = fetch_byte(ip)
        switch opcode:
            case CONST_U128:
                val = const_pool[fetch_u16(ip)]
                push_operand(val)
                gas_consume(BASE_COST_CONST)
            case LOAD_LOCAL:
                reg = fetch_u8(ip)
                push_operand(frame.locals[reg])
                gas_consume(BASE_COST_LOAD)
            case ADD:
                b = pop_operand(); a = pop_operand()
                res = a + b  // trap on overflow
                push_operand(res)
                gas_consume(BASE_COST_ADD)
            case HOST_GET:
                key_ptr = pop_operand(); key_len = pop_operand()
                gas_consume(cost = HOST_GET_BASE + key_len * HOST_GET_PER_BYTE)
                val = host.get(memory.slice(key_ptr, key_len))
                push_operand(store_bytes_in_memory(val))
            case CALL:
                callee_idx = fetch_u16(ip)
                // push return ip + new frame
                call_args = pop N args
                execute_function(callee_idx, call_args, ctx)
                gas_consume(BASE_COST_CALL)
            case RET:
                ret_val = pop_operand_optional()
                pop_frame()
                if callstack empty: return ret_val
                else push_operand(ret_val)
            case JMP:
                offset = fetch_i32(ip)
                ip += offset
            case JMP_IF_FALSE:
                cond = pop_operand()
                if not cond: ip += fetch_i32(ip)
                gas_consume(BASE_COST_JMP)
            case HALT:
                raise Trap("halt")
        if gas_exhausted: trap
        if instruction_count > limit: trap
    end while
