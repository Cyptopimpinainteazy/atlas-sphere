logic_or    = logic_and { "or" logic_and } ;
logic_and   = equality { "and" equality } ;
equality    = compare { ("==" | "!=") compare } ;
compare     = term { (">" | "<" | ">=" | "<=") term } ;
term        = factor { ("+" | "-") factor } ;
factor      = unary { ("*" | "/" | "%") unary } ;
unary       = [ "-" | "not" ] primary ;
