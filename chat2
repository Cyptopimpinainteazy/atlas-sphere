2 — Bytecode container format (on-disk / wire)
X3B FILE {
  magic: 4 bytes "X3B\0"
  version: u16
  flags: u16
  header {
    const_pool_count: u32
    code_offset: u32
    code_size: u32
    func_count: u32
    max_stack: u16
  }
  CONSTANT_POOL [const_pool_count] {
