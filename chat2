  program_hash: bytes,          // sha256 of bytecode
  input_hash: bytes,            // hash of input params/state snapshot
  trace_root: bytes,            // Merkle root of execution trace (opcodes+outputs)
  state_deltas_root: bytes,     // Merkle root of state writes (key->value)
